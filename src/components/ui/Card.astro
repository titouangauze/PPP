---
import Tags from '@components/ui/Tags.astro';
import { Image } from 'astro:assets';

interface Props {
    url?: string;
    alt?: string;
    title?: string;
    description: string;
    tags: string[];
    children?: HTMLElement | HTMLElement[];
    color?: string;
    modalId?: string;
    image?: string;
}

const {
    url = '#',
    alt = 'Project image',
    description = 'Project Description',
    title = 'Project title',
    tags = ['Tags'],
    modalId,
    image,
} = Astro.props;
---

<section class="w-full p-4 md:w-1/2 lg:w-1/3">
    <article
        data-testId="card"
        class="cursor-pointer rounded-xl bg-white p-3 shadow-lg duration-100 hover:scale-105 hover:transform hover:shadow-xl"
    >
        <div class="mt-1 p-2" onclick={`event.preventDefault(); document.getElementById('${modalId}')?.classList.add('active')`}>
            <h3 class="text-xl text-orange lg:text-2xl">{title}</h3>
            {image && (
                <img
                    src={image}
                    alt={alt}
                    class="mb-4 h-48 w-full rounded-lg object-cover"
                />
            )}
            <Tags tags={tags} />
        </div>
    </article>
</section>