---
import Layout from '@layouts/Layout.astro';
---

<Layout title="Contact">
	<section class="min-h-screen flex flex-col items-center justify-center py-20">
		<div class="w-full max-w-3xl px-6 md:px-8">
			<h1 class="text-4xl font-bold text-orange mb-10 " style="padding-left: 10px;">Me Contacter</h1>
			
			<form method="POST" action="https://formspree.io/f/YOUR_FORM_ID" class="bg-white dark:bg-zinc-900 rounded-xl shadow-lg p-10 md:p-12">
				<!-- Nom -->
				<div class="mb-6" style="padding-top: 10px">
					<label for="name" class="block text-black dark:text-white font-semibold mb-2 " style="padding-left: 10px;">
						Nom
					</label>
					<input
						type="text"
						id="name"
						name="name"
						required
						class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-white text-black focus:outline-none focus:border-orange"
						placeholder="Votre nom"
					/>
				</div>

				<!-- Email -->
				<div class="mb-6">
					<label for="email" class="block text-black dark:text-white font-semibold mb-2 " style="padding-left: 10px;">
						Email
					</label>
					<input
						type="email"
						id="email"
						name="email"
						required
						class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-white text-black focus:outline-none focus:border-orange"
						placeholder="votre.email@exemple.com"
					/>
				</div>

				<!-- Sujet -->
				<div class="mb-6">
					<label for="subject" class="block text-black dark:text-white font-semibold mb-2 " style="padding-left: 10px;">
						Sujet
					</label>
					<input
						type="text"
						id="subject"
						name="subject"
						required
						class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-white text-black focus:outline-none focus:border-orange"
						placeholder="Sujet de votre message"
					/>
				</div>

				<!-- Message -->
				<div class="mb-6">
					<label for="message" class="block text-black dark:text-white font-semibold mb-2 " style="padding-left: 10px;">
						Message
					</label>
					<textarea
						id="message"
						name="message"
						required
						rows={6}
						class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-white text-black focus:outline-none focus:border-orange resize-none"
						placeholder="Votre message..."
					></textarea>
				</div>

				<!-- Bouton d'envoi -->
				<div class="flex gap-4 justify-center" style="padding-bottom: 10px;">
					<button
						type="submit"
						class="bg-orange text-white font-semibold py-2 px-8 rounded-lg hover:opacity-90 transition duration-200"
					>
						Envoyer
					</button>
					<a
						href="/"
						class="bg-gray-300 dark:bg-zinc-700 text-black dark:text-white font-semibold py-2 px-8 rounded-lg hover:opacity-90 transition duration-200 " style="padding-left: 10px;"
					>
						Retour
					</a>
				</div>
			</form>
		</div>
	</section>
</Layout>
