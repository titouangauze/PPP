---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Récupération des projets
const projects = await getCollection('projects');
---

<Layout title="Tous mes projets">
	<section class="mx-auto max-w-6xl px-6 py-16">
		<!-- Titre -->
		<h1 class="mb-12 text-4xl font-bold" style="color: #E06330;">Tous mes projets</h1>

		<!-- Grille -->
		<div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
			{
				projects.map((project) => (
					<article
						class="dark:bg-zinc-900 group rounded-xl bg-white p-6 shadow transition hover:shadow-2xl"
						style="color: black;"
					>
						{/* Image */}
						{project.data.image && (
							<img
								src={project.data.image}
								alt={project.data.img_alt || project.data.title}
								class="mb-4 h-48 w-full rounded-lg object-cover"
							/>
						)}

						{/* Titre */}
						<h2 class="text-xl font-semibold transition group-hover:text-orange">
							{project.data.title}
						</h2>

						{/* Description */}
						<p class="mt-2 text-sm opacity-80">{project.data.description}</p>

						{/* Tags */}
						<div class="mt-3 flex flex-wrap gap-2">
							{project.data.tags.map((tag) => (
								<span class="bg-gray-200 dark:bg-zinc-700 rounded px-2 py-1 text-xs">{tag}</span>
							))}
						</div>

						{/* Bouton Lien */}
						<div class="mt-4 flex gap-4">
							<a
								href={project.data.link}
								class="pointer-events-auto relative z-20 text-sm font-medium text-orange hover:underline"
							>
								Voir le projet →
							</a>
						</div>

						{/* Badge En cours */}
						{project.data.inProgress && (
							<div class="mt-4">
								<span class="rounded bg-orange px-2 py-1 text-xs text-white">En cours</span>
							</div>
						)}
					</article>
				))
			}
		</div>
    </br>
		<div>
			<!-- Bouton retour -->
			<a
				href="/"
				class="text-gray-600 dark:text-gray-300 group mb-10 inline-flex items-center gap-2 text-sm font-medium transition hover:text-orange"
                style="color: #E06330;"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					fill="none"
					viewBox="0 0 24 24"
					stroke-width="1.5"
					stroke="currentColor"
					class="h-4 w-4 transition group-hover:-translate-x-1"
				>
					<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"
					></path>
				</svg>
				Retour à l'accueil
			</a>
		</div>
	</section>
</Layout>
